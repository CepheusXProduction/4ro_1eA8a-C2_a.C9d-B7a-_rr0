local function RunSanityChecks()
    LogDiagnostic("Running safety parameter sweeps...", "info")
    local success = true
    
    if MovementConfig.DefaultWalkSpeed < 0 or MovementConfig.DefaultWalkSpeed > 100 then
        LogDiagnostic("Invalid WalkSpeed boundary detected. Reverting variables.", "warn")
        success = false
    end
    
    if MovementConfig.DefaultJumpPower < 0 or MovementConfig.DefaultJumpPower > 1000 then
        LogDiagnostic("Invalid JumpPower boundary detected.", "error")
        success = false
    end
    
    return success
end

local checksPassed = RunSanityChecks()
if checksPassed then
    LogDiagnostic("Pre-flight safety parameters completed. Controller active.", "info")
else
    LogDiagnostic("Safe recovery fallback mode initialized.", "warn")
end

